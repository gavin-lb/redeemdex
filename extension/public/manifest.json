{
  "manifest_version": 3,
  "name": "RedeemDex",
  "version": "1.3.1",
  "description": "Enter, track, validate, and redeem Pokémon TCG Live codes.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://redeem.tcg.pokemon.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "RedeemDex",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://redeem.tcg.pokemon.com/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ptcgl-code-redeemer@example.invalid"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
