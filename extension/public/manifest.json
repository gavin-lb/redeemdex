{
  "manifest_version": 3,
  "name": "RedeemDex",
  "version": "1.4.1",
  "description": "Redeeming Pokémon TCG Live codes made easy.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://redeem.tcg.pokemon.com/*"],
  "action": {
    "default_title": "RedeemDex",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://redeem.tcg.pokemon.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
